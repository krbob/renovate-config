{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "./base"
  ],
  "schedule": [
    "* * 1 * *"
  ],
  "updateNotScheduled": true,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * 1 * *"
    ],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
